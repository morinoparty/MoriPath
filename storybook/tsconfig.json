{
    "compilerOptions": {
        "strict": true,
        "noEmit": true,
        "skipLibCheck": true,
        "lib": ["DOM", "DOM.Iterable", "ES2022"],
        "target": "ES2022",
        "module": "ES2022",
        "moduleResolution": "bundler",
        "jsx": "react-jsx",
        "baseUrl": ".",
        "paths": {
            "@/*": ["../app/src/*"],
            "styled-system/*": ["../app/styled-system/*"]
        },
        "esModuleInterop": true,
        "resolveJsonModule": true,
        "types": ["vite/client", "node"]
    },
    "include": [
        "stories/**/*",
        ".storybook/**/*",
        "vite.config.ts",
        "panda.config.ts",
        "../app/src/**/*"
    ]
}
