{
    "name": "moripath-workspace",
    "version": "0.1.0",
    "private": true,
    "scripts": {
        "dev": "pnpm --filter @moripath/app dev",
        "dev:storybook": "pnpm --filter @moripath/storybook dev",
        "dev:all": "pnpx concurrently \"pnpm dev\" \"pnpm dev:storybook\"",
        "build": "pnpm --filter @moripath/app build",
        "build:storybook": "pnpm --filter @moripath/storybook build",
        "build:all": "pnpx concurrently \"pnpm build\" \"pnpm build:storybook\"",
        "deploy": "pnpm --filter @moripath/app deploy",
        "deploy:storybook": "pnpm --filter @moripath/storybook deploy",
        "cf-typegen": "pnpm --filter @moripath/app cf-typegen",
        "check": "biome check ./ --write"
    },
    "devDependencies": {
        "@biomejs/biome": "2.3.9"
    },
    "packageManager": "pnpm@10.15.0"
}
