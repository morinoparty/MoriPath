{
    "name": "moripath-workspace",
    "version": "0.1.0",
    "private": true,
    "scripts": {
        "dev": "pnpm --filter @moripath/app dev",
        "dev:storybook": "pnpm --filter @moripath/storybook dev",
        "dev:all": "pnpx concurrently \"pnpm dev\" \"pnpm dev:storybook\"",
        "build": "pnpm run build:storybook && pnpm --filter @moripath/app build",
        "build:storybook": "node -e \"require('node:fs').rmSync('storybook/storybook-static',{recursive:true,force:true})\" && vp run build-storybook",
        "deploy": "pnpm run build:storybook && pnpm --filter @moripath/app run deploy",
        "cf-typegen": "pnpm --filter @moripath/app cf-typegen",
        "check": "vp check --fix",
        "check:ci": "vp check",
        "typecheck": "pnpm --filter @moripath/app typecheck"
    },
    "devDependencies": {
        "lefthook": "^2.2.2",
        "vite-plus": "catalog:"
    },
    "packageManager": "pnpm@12.14.0",
    "engines": {
        "node": ">=26"
    }
}
