# Copy to .env / .dev.vars for local dev.
# AUTH_SECRET is stored in Bitwarden Secrets Manager (project: morinoparty)
# and in Cloudflare Secrets Store for the deployed Worker, wired via
# `secrets_store_secrets` in wrangler.jsonc — NOT read from this file.
# BSM: shared/AUTH_SECRET / CF Secrets Store: shared_AUTH_SECRET
# For local `wrangler dev`, seed a local value with:
#   wrangler secrets-store secret create d36d5a11ea07462c83bb21a0e9ccb811 --name shared_AUTH_SECRET --scopes workers
# AUTH_SECRET=
MAIN_SERVER_URL=https://api.morino.party/main
SERVER_URL=https://api.morino.party/
SERVERS=main,res,lobby
CLIENT_ID=019bc133-d5e1-7306-b230-8ca433d1001f
REDIRECT_AUTH_URL=http://localhost:3000
