# Copy to .env / .dev.vars for local dev.
# AUTH_SECRET is stored in Bitwarden Secrets Manager (project: morinoparty, key: shared/AUTH_SECRET).
# CI fetches it with bitwarden/sm-action and uploads it as a Worker secret via
# `cf deploy --secrets-file`. For local dev, put any random value (>= 32 chars) here.
# AUTH_SECRET=
MAIN_SERVER_URL=https://api.morino.party/main
SERVER_URL=https://api.morino.party/
SERVERS=main,res,lobby
CLIENT_ID=019bc133-d5e1-7306-b230-8ca433d1001f
