# .env にコピーして使う
# GitHub Actions には `gh secret set -f .env` で登録する

# cf CLI 用
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# Worker secret
# AUTH_SECRET は 32 文字以上のランダムな値
AUTH_SECRET=
# `${SERVER_URL}servers` からサーバー一覧と認証サーバーを解決する
SERVER_URL=
# プレイヤー情報・画像 API
MC_API_URL=
# Minecraft のモデル・テクスチャ・言語ファイル (mc-assets) の配信元
MC_ASSETS_URL=
# ワールドマップ (squaremap) の公開 URL
WORLD_MAP_URL=
# もりとぱの AI 日記 API (moritopa diary-api)
DIARY_API_URL=
# diary-api の Worker secret と同じ値
DIARY_SHARED_KEY=

# 任意。保護ブロック 1 つのどんぐり (GriefPrevention の ClaimBlocksPurchaseCost と同じ値)
# 未設定なら /balance-claim は合計の目安と「最大」を出さない。本番で使うときは cloudflare.config.ts に bindings.text で宣言する
# CLAIM_BLOCK_PRICE=

# cloudflare.config.ts の CLIENT_ID を上書きする場合のみ
# リダイレクト URI は <origin>/api/auth/callback/MineAuth
# CLIENT_ID=
