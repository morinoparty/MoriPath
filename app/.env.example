# .env にコピーして使う
# GitHub Actions には `gh secret set -f .env` で登録する

# cf CLI 用
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# Worker secret
# AUTH_SECRET は 32 文字以上のランダムな値
AUTH_SECRET=
# `${SERVER_URL}servers` からサーバー一覧と認証サーバーを解決する
SERVER_URL=
# プレイヤー情報・画像 API
MC_API_URL=

# cloudflare.config.ts の CLIENT_ID を上書きする場合のみ
# リダイレクト URI は <origin>/api/auth/callback/MineAuth
# CLIENT_ID=
