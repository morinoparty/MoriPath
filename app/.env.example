# .env にコピーして使う (.env は git 管理外)。
# GitHub Actions には `gh secret set -f .env` で同じキーを登録する。

# cf CLI 用 (Worker には渡さない)
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# Worker secret。CI は GitHub Actions secrets から `cf deploy --secrets-file` でアップロードする。
# ローカル開発では AUTH_SECRET に 32 文字以上のランダムな値を入れる。
AUTH_SECRET=
# サーバー一覧は `${SERVER_URL}servers` から取得し、先頭から順に認証サーバー (MineAuth) を解決する
# (例: https://api.morino.party/)
SERVER_URL=

# ローカル開発で cloudflare.config.ts の CLIENT_ID (var) を上書きする場合のみ
# (MineAuth 側に登録するリダイレクト URI は <origin>/api/auth/callback/MineAuth)
# CLIENT_ID=019bc133-d5e1-7306-b230-8ca433d1001f
